# Sao chép file này thành .env và điền thông tin thực tế
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tahanews
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=          # Bỏ comment nếu Redis có password

# ── Crawler ───────────────────────────────────────────────────────────────────
CRAWLER_INTERVAL_MINUTES=30
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30

# ── Cache TTL ─────────────────────────────────────────────────────────────────
# ARTICLE_CACHE_TTL_SECONDS=604800   # 7 ngày (mặc định)
