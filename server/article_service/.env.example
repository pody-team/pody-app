# Sao chép file này thành .env và điền thông tin thực tế
# cp .env.example .env

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tahanews
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=          # Bỏ comment nếu Redis có password

# ── Crawler ───────────────────────────────────────────────────────────────────
CRAWLER_INTERVAL_MINUTES=30
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30

# ── Cache TTL ─────────────────────────────────────────────────────────────────
# ARTICLE_CACHE_TTL_SECONDS=604800   # 7 ngày (mặc định)

# ── AI Podcast ────────────────────────────────────────────────────────────────
AI_PROVIDER_MODE=auto
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_MODEL=gemini-2.5-flash
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
GOOGLE_GENAI_BASE_URL=
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1/web/search

# ── MinIO cho Article Podcast ────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_REGION=us-east-1
MINIO_PUBLIC_BASE_URL=http://localhost:9000
MINIO_USE_SSL=false
ARTICLE_PODCAST_BUCKET=article-podcasts
