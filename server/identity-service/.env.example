PORT=8081
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pody_identity?sslmode=disable
JWT_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TTL=24h
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=identity-service
KAFKA_WRITE_TIMEOUT=5s
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=20
OUTBOX_RETENTION=168h
OUTBOX_CLEANUP_INTERVAL=1h
OUTBOX_CLEANUP_BATCH_SIZE=200
VERIFICATION_EVENTS_TOPIC=identity.email.verification.requested
EMAIL_VERIFICATION_URL_BASE=http://localhost:8080/api/v1/public/identity/verify-email
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com
