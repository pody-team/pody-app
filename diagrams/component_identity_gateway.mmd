flowchart LR
    Guest[Guest / User] --> App[Flutter App]
    App --> Gateway[API Gateway]

    subgraph GW["api-gateway"]
        PublicRoutes[Public Route Group]
        ProtectedRoutes[Protected Route Group]
        JWT[JWT Middleware]
        Proxy[Reverse Proxy]
        Meta[Route Metadata / Docs]
    end

    subgraph ID["identity-service"]
        Auth[Auth Handler]
        Google[Google Sign-In Handler]
        Profile[Profile Handler]
        Token[Token Service]
        Outbox[Outbox Publisher]
    end

    DB[(Identity DB)]
    Kafka[(Kafka)]
    Notification[Notification Service]

    Gateway --> PublicRoutes
    Gateway --> ProtectedRoutes
    ProtectedRoutes --> JWT --> Proxy
    PublicRoutes --> Proxy
    Proxy --> Auth
    Proxy --> Google
    Proxy --> Profile
    Proxy --> Meta
    Auth --> Token
    Google --> Token
    Auth --> DB
    Google --> DB
    Profile --> DB
    Token --> DB
    Outbox --> DB
    Outbox --> Kafka --> Notification
