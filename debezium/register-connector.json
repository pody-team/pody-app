{
  "name": "article-embedding-connector",
  "config": {
    "tasks.max": "1",
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "article-postgres",
    "database.port": "5432",
    "database.user": "postgres",
    "database.password": "postgres",
    "database.dbname": "pody_article",
    "topic.prefix": "pody.article.cdc",
    "plugin.name": "pgoutput",
    "schema.include.list": "public",
    "table.include.list": "public.articles",
    "message.key.columns": "public.articles:id",
    "slot.name": "article_service_articles_slot",
    "publication.name": "article_service_articles_publication",
    "publication.autocreate.mode": "filtered",
    "snapshot.mode": "initial",
    "skipped.operations": "d,t",
    "tombstones.on.delete": "false",
    "include.schema.changes": "false",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "unwrap,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.unwrap.delete.handling.mode": "drop",
    "transforms.unwrap.add.fields": "op,table,source.ts_ms",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "pody\\.article\\.cdc\\.public\\.articles",
    "transforms.route.replacement": "article.embedding.requested"
  }
}
